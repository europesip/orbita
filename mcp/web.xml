<?xml version="1.0" encoding="UTF-8"?>
<!-- Servidor MCP de ÓRBITA (orbita-mcp.war): raíz "/" del puerto del MCP (9081, virtualHost mcp_host en server.xml, enlazado en ibm-web-bnd.xml).
     Sin restricciones de seguridad de servlet: el acceso se limita por red (NetworkPolicy, sin Ingress) y, si se
     define ORBITA_MCP_TOKEN, con un token Bearer (McpServlet). Ver mcp/README.md. -->
<web-app xmlns="http://xmlns.jcp.org/xml/ns/javaee" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
    xsi:schemaLocation="http://xmlns.jcp.org/xml/ns/javaee http://xmlns.jcp.org/xml/ns/javaee/web-app_3_1.xsd"
    version="3.1">
  <display-name>ORBITA MCP</display-name>

  <servlet>
    <servlet-name>mcp</servlet-name>
    <servlet-class>com.demo.orbita.mcp.McpServlet</servlet-class>
  </servlet>
  <servlet-mapping>
    <servlet-name>mcp</servlet-name>
    <url-pattern>/mcp</url-pattern>
  </servlet-mapping>

  <servlet>
    <servlet-name>probe</servlet-name>
    <servlet-class>com.demo.orbita.mcp.ProbeServlet</servlet-class>
  </servlet>
  <servlet-mapping>
    <servlet-name>probe</servlet-name>
    <url-pattern>/probe/ready</url-pattern>
  </servlet-mapping>
</web-app>
